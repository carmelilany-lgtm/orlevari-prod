# Supabase (public — safe in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SERVER ONLY, never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Admin allow-list (comma-separated, fallback until admin_users is populated)
ADMIN_ALLOWED_EMAILS=

# Resend — SERVER ONLY (never NEXT_PUBLIC_)
# Get API key: https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender in Resend (domain must be verified in Resend dashboard)
# Example: Lev Ari Productions <noreply@yourdomain.com>
EMAIL_FROM=

# Or's inbox for new lead notifications (server-only)
CONTACT_NOTIFICATION_EMAIL=

# Site URL for auth redirects and canonical / Open Graph (must be the public HTTPS
# domain in production — never localhost, or WhatsApp/Facebook previews break)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — site WhatsApp display (public contact section)
WHATSAPP_PHONE=
